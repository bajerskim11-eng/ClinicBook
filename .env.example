# ── Supabase (required) ──────────────────────────────────────────────
# Create a project at https://supabase.com/dashboard/new, then copy
# these from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Either the legacy anon key or the newer publishable key works (see src/lib/supabase/env.ts).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only — never expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App (required) ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
# Required in production to authorize /api/cron/* endpoints (see README "Scheduling").
CRON_SECRET=change-me-to-a-long-random-string

# ── Email (required for booking confirmations/reminders) ──────────────
# resend = production (recommended). ethereal = local dev/testing only.
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key
# Must be a verified sender/domain in your Resend account.
EMAIL_FROM="ClinicBook <noreply@yourdomain.com>"
# Dev-only alternative — run `npm run setup-ethereal` to generate these, then:
# EMAIL_PROVIDER=ethereal
# ETHEREAL_USER=
# ETHEREAL_PASS=

# ── SMS (optional — console.log stub only, no real provider wired up) ──
SMS_PROVIDER=console

# ── Stripe (optional — billing is not implemented yet, reserved for future use) ──
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Calendar sync (optional — feature flag, disabled by default) ───────
CALENDAR_SYNC_ENABLED=false
